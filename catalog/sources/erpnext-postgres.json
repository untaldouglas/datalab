{
  "apiVersion": "catalog.university.local/v1alpha1",
  "kind": "CatalogSource",
  "metadata": {"name": "erpnext-postgres", "owner": "admin", "description": "Fuente PostgreSQL de ERPNext con facturas de estudiantes y operaciones financieras del laboratorio."},
  "spec": {
    "environment": "local",
    "service": {"name": "ERPNext_Postgres", "type": "Postgres", "database": "erpnext_db", "includeSchemas": ["erp"]},
    "access": {"credentialsRef": "airflow-secret://openmetadata/erpnext-postgres-reader", "mode": "read-only"},
    "ingestion": {
      "metadata": {"enabled": true, "schedule": "15 2 * * *", "timezone": "America/El_Salvador"},
      "profiler": {"enabled": true, "schedule": "15 3 * * *", "timezone": "America/El_Salvador", "generateSampleData": false},
      "quality": {"enabled": true, "schedule": "0 4 * * *", "timezone": "America/El_Salvador", "initialTests": ["row_count_positive"]}
    },
    "governance": {"defaultOwner": "admin", "classification": "restricted"}
  }
}
