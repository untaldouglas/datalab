{
  "apiVersion": "catalog.university.local/v1alpha1",
  "kind": "CatalogSource",
  "metadata": {"name": "erp-mssql", "owner": "admin", "description": "Fuente transaccional ERP legado con facturación, compras y clientes del laboratorio universitario."},
  "spec": {
    "environment": "local",
    "service": {"name": "ERP_MSSQL", "type": "MSSQL", "database": "erpnext_db", "includeSchemas": ["erp"]},
    "access": {"credentialsRef": "airflow-secret://openmetadata/erp-mssql-reader", "mode": "read-only"},
    "ingestion": {
      "metadata": {"enabled": true, "schedule": "5 2 * * *", "timezone": "America/El_Salvador"},
      "profiler": {"enabled": true, "schedule": "5 3 * * *", "timezone": "America/El_Salvador", "generateSampleData": false},
      "quality": {"enabled": true, "schedule": "0 4 * * *", "timezone": "America/El_Salvador", "initialTests": ["row_count_positive"]}
    },
    "governance": {"defaultOwner": "admin", "classification": "restricted"}
  }
}
